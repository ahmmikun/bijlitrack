# ==========================================
# BijliTrack - Environment Configuration
# ==========================================

# MongoDB Atlas Connection URI (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bijlitrack?retryWrites=true&w=majority

# JWT Secret for Session Authentication (Required)
JWT_SECRET=your-secure-random-jwt-secret-key-here

# Optional: Secret token to authorize Vercel Cron requests
CRON_SECRET=your-random-cron-secret-token

# Main AI Provider: Claude Vision & Language (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Optional: override the vision model. Default is claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Fallback AI Provider: Google Gemini (free tier at aistudio.google.com)
# Automatically used if Claude key is omitted, or as fallback on Claude errors/rate limits
GEMINI_API_KEY=your-gemini-api-key

# Optional: override Gemini model. Default is gemini-3.5-flash (or gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Force AI provider order ('claude' | 'gemini', default: claude main with gemini fallback)
AI_PROVIDER=

# Optional: SMTP Email service for password reset emails
APP_NAME=BijliTrack
MAIL_FROM="BijliTrack <no-reply@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Optional: Frontend API URL override (defaults to same-origin /api)
# NEXT_PUBLIC_API_URL=https://your-domain.vercel.app/api
